/// @title DCRCompaniesLLP ERC20 token with whitelist & simple gas reimbursement helpers
/// @notice Based on OpenZeppelin ERC20 and Ownable
contract DCRCompaniesLLP is ERC20, Ownable {
    mapping(address => bool) public apiWhitelist;
    // Example placeholder addresses you provided (kept intact for reference)
    // address public constant ACCOUNT_A = 0xeCC6fbDE07c366034D4284B422e4Ba4511f060b0;
    // address public constant ACCOUNT_B = 0x92eBC86A610E3A4A113A54869a41b073fe2Fda52;
    event WhitelistUpdated(address indexed account, bool indexed isWhitelisted);
    event GasReimbursementSent(address indexed to, uint256 amountWei);
    constructor(uint256 initialSupplyTokens) ERC20("DCRCompanyLLP", "DCROx") {
        // initialSupplyTokens - units in whole tokens (will be multiplied by 10**decimals)
        _mint(msg.sender, initialSupplyTokens * (10 ** decimals()));
    }
    modifier onlyWhitelisted() {
        require(apiWhitelist[_msgSender()], "Caller is not whitelisted");
        _;
    }
    // --- Whitelist management ---
    function updateWhitelist(address account, bool isWhitelisted) external onlyOwner {
        apiWhitelist[account] = isWhitelisted;
        emit WhitelistUpdated(account, isWhitelisted);
    }
    // Example restricted function that only whitelisted callers can invoke
    function whitelistedTransfer(address from, address to, uint256 amount) external onlyWhitelisted returns (bool) {
        _transfer(from, to, amount);
        return true;
    }
    // --- Gas reimbursement / claim functions ---
    /// @notice Owner funds the contract with ETH to reimburse gas
    receive() external payable {}
    /// @notice Owner can call to reimburse a participant (simple example)
    /// @dev OnlyOwner 'Michael Watkins'; in production add more checks and accounting
    function withdrawGasReimbursement(address payable recipient, uint256 amountWei) external onlyOwner {
        require(address(this).balance >= amountWei, "Insufficient contract ETH balance");
        (bool success, ) = recipient.call{value: amountWei}("");
        require(success, "ETH transfer failed");
        emit GasReimbursementSent(recipient, amountWei);
    }
    /// @notice Convenience: owner can withdraw ERC20 tokens from contract (if any)
    function withdrawERC20(address tokenAddress, address to, uint256 amount) external onlyOwner {
        IERC20(tokenAddress).transfer(to, amount);
    }
    // Note: standard ERC20 transfer/approve functions inherited from OpenZeppelin
}
 
